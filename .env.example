# ============================================================
# SoroStream Environment Variables
# ============================================================
# Copy this file to .env.local and fill in the values.
#
#   cp .env.example .env.local
#
# Variables prefixed with NEXT_PUBLIC_ are embedded into the
# browser bundle at build time. Changing them requires a full
# rebuild (next build). Variables without that prefix are only
# available server-side and can be updated without rebuilding.
#
# Lines marked "# Required in production" hold sensitive or
# deployment-specific values that must be set before a mainnet
# deploy. Never commit real values — only .env.example is tracked.
#
# See docs/DEPLOYMENT.md for the full deployment guide.
# ============================================================


# ------------------------------------------------------------
# REQUIRED — the app will refuse to start if these are missing
# ------------------------------------------------------------

# Stellar network to connect to.
# Valid values: "testnet" | "mainnet"
# Default: "testnet"
# ⚠ Rebuild required when changed (NEXT_PUBLIC_ prefix).
NEXT_PUBLIC_STELLAR_NETWORK=testnet

# On-chain address of the deployed SoroStream contract.
# Obtain this after deploying the contract with the Soroban CLI.
# Example: CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCN
# ⚠ Rebuild required when changed (NEXT_PUBLIC_ prefix).
NEXT_PUBLIC_CONTRACT_ID=


# ------------------------------------------------------------
# OPTIONAL — sensible defaults are used when not set
# ------------------------------------------------------------

# Soroban JSON-RPC endpoint.
# Defaults to the public Stellar testnet RPC when not set.
# Override for mainnet or a private/dedicated RPC node.
# Examples:
#   testnet  → https://soroban-testnet.stellar.org
#   mainnet  → https://mainnet.stellar.validationcloud.io/v1/<API_KEY>
# ⚠ Rebuild required when changed (NEXT_PUBLIC_ prefix).
# Required in production (mainnet URLs often embed a provider API key).
NEXT_PUBLIC_RPC_URL=https://soroban-testnet.stellar.org

# Web Vitals reporting endpoint (optional)
# Set to a URL that accepts POST requests with JSON metric payloads.
# Leave empty to disable remote reporting (vitals are still logged to the
# console in development mode).
# Example: https://your-api.example.com/api/vitals
NEXT_PUBLIC_VITALS_ENDPOINT=

# Fee sponsor address (optional)
# Stellar public key of the fee sponsor account used to pay transaction fees
# via fee-bump transactions. When set, users can submit transactions without
# holding XLM for fees. Leave empty to disable fee sponsorship.
# Example: GXXX...YYYY
# ⚠ Rebuild required when changed (NEXT_PUBLIC_ prefix).
# Required in production when fee sponsorship is enabled.
NEXT_PUBLIC_FEE_SPONSOR_ADDRESS=

# Admin wallet addresses
# Comma-separated Stellar public keys allowed to open the /admin page. Any
# other wallet (or no wallet) is redirected to / with an "Access denied" toast.
# When empty, nobody can access /admin. This is a client-side gate only —
# on-chain admin checks in the contract remain the real authority.
# Example: GABCDEF...,GHIJKLM...
# Required in production.
NEXT_PUBLIC_ADMIN_ADDRESSES=
# Backward-compatible aliases, used only when NEXT_PUBLIC_ADMIN_ADDRESSES is
# empty. Prefer NEXT_PUBLIC_ADMIN_ADDRESSES for new setups.
NEXT_PUBLIC_ADMIN_ADDRESS=
NEXT_PUBLIC_ADMIN_WALLET=

# App base URL (optional, for OG image generation)
# Used to generate proper URLs for Open Graph and Twitter Card metadata
# Leave empty to use the default (https://sorostream-app.vercel.app)
# Example: https://your-domain.com
NEXT_PUBLIC_APP_URL=

# Extra SEP-1 stellar.toml probe domains (optional, #699)
# Comma-separated hostnames appended to the default probe list
# (stellar.org, lobstr.co, stellarterm.com) when resolving [[ACCOUNTS]]
# display names. Schemes/paths/ports are stripped and duplicates ignored;
# anything that is not a hostname is skipped.
# Example: selfhosted.example.com,issuer.example.org
# ⚠ Rebuild required when changed (NEXT_PUBLIC_ prefix).
NEXT_PUBLIC_TOML_EXTRA_DOMAINS=

# RPC health indicator thresholds (optional)
# Latency (ms) above which the indicator turns yellow (degraded).
# Default: 2000
NEXT_PUBLIC_RPC_DEGRADED_MS=2000

# Seconds the RPC must be unreachable before a full-width banner is shown.
# Default: 60
NEXT_PUBLIC_RPC_UNREACHABLE_BANNER_S=60

# Contract version this build expects to be deployed (optional).
# On load, the app queries the deployed contract's `version` instruction and
# compares it against this value. A mismatch shows a "please refresh" banner.
# Leave empty to disable the check.
# ⚠ Rebuild required when changed (NEXT_PUBLIC_ prefix).
NEXT_PUBLIC_CONTRACT_VERSION=1.2.0

# Web Push VAPID public key (optional, #523)
# The URL-safe base64-encoded VAPID public key generated by your push server.
# When set, the browser subscribes to push using this key so the server can
# send encrypted push messages even when the app tab is closed.
# Generate a key pair with: npx web-push generate-vapid-keys
# Leave empty to use in-tab-only notifications (service worker fallback).
# ⚠ Rebuild required when changed (NEXT_PUBLIC_ prefix).
# Required in production. Keep the matching VAPID *private* key on the push
# server only — it must never be given a NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
